generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Temporary bootstrap-only table. It has no business/runtime responsibility.
// Remove it with a new migration when the first real domain migration makes it unnecessary;
// do not rewrite the committed bootstrap migration.
model PlatformMetadata {
  key       String   @id @db.VarChar(100)
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_metadata")
}
