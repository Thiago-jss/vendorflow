generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  MANAGER
  BUYER
  FINANCE
  ADMIN

  @@map("role")
}

/// Why an AuthSession stopped being usable. ROTATED marks the predecessor of a
/// successful refresh rotation; REUSE_DETECTED marks every still-active session of a
/// family whose already-rotated token was presented again.
enum AuthSessionRevocationReason {
  ROTATED
  LOGOUT
  REUSE_DETECTED
  PRINCIPAL_INACTIVE

  @@map("auth_session_revocation_reason")
}

/// BR-010. Every state the purchase request lifecycle defines, declared in full so the
/// database never has to be migrated to admit a state the domain already knows about. The
/// transitions a phase actually implements are an application concern; see
/// apps/api/src/procurement/application/support/purchase-request-status.ts.
enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  IN_QUOTATION
  IN_FINAL_APPROVAL
  APPROVED
  ORDERED
  REJECTED
  CANCELLED

  @@map("purchase_request_status")
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches    Branch[]
  departments Department[]
  users       User[]
  userRoles   UserRole[]
  authSessions AuthSession[]
  purchaseRequests PurchaseRequest[]
  purchaseRequestItems PurchaseRequestItem[]
  approvalFlows ApprovalFlow[]
  approvalSteps ApprovalStep[]
  auditEvents AuditEvent[]
  outboxMessages OutboxMessage[]
  outboxConsumerReceipts OutboxConsumerReceipt[]
  suppliers Supplier[]
  supplierQuotes SupplierQuote[]
  supplierQuoteItems SupplierQuoteItem[]
  purchaseOrders PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  purchaseOrderNumberSequence PurchaseOrderNumberSequence?
  idempotencyRecords IdempotencyRecord[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  departments  Department[]
  users        User[]

  @@unique([organizationId, id], map: "branches_organization_id_id_key")
  @@unique([organizationId, name], map: "branches_organization_id_name_key")
  @@map("branches")
}

model Department {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  name           String   @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  users        User[]
  purchaseRequests PurchaseRequest[]

  @@unique([organizationId, id], map: "departments_organization_id_id_key")
  @@unique([organizationId, branchId, id], map: "departments_organization_id_branch_id_id_key")
  @@unique([organizationId, branchId, name], map: "departments_organization_id_branch_id_name_key")
  @@map("departments")
}

model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  departmentId   String   @map("department_id") @db.Uuid
  name           String   @db.VarChar(200)
  email          String   @unique(map: "users_email_key") @db.VarChar(320)
  /// Argon2id PHC string. Nullable because a User may exist before any credential-
  /// management flow gives it one; such a User can never authenticate. There is no
  /// default, no backfill and no seed credential. A database CHECK constraint (SQL only)
  /// additionally requires NULL or an Argon2id PHC value.
  passwordHash   String?  @map("password_hash") @db.VarChar(255)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch       Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  department   Department   @relation(fields: [organizationId, branchId, departmentId], references: [organizationId, branchId, id], onDelete: Restrict, onUpdate: Restrict)
  roles        UserRole[]
  authSessions AuthSession[]
  purchaseRequests PurchaseRequest[]
  decidedApprovalSteps ApprovalStep[]
  auditEvents AuditEvent[]
  registeredSupplierQuotes SupplierQuote[] @relation("SupplierQuoteRegisteredBy")
  selectedSupplierQuotes SupplierQuote[] @relation("SupplierQuoteSelectedBy")
  issuedPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderIssuedBy")
  cancelledPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderCancelledBy")
  idempotencyRecords IdempotencyRecord[]

  @@unique([organizationId, id], map: "users_organization_id_id_key")
  @@map("users")
}

model UserRole {
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           Role
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([organizationId, userId, role], map: "user_roles_pkey")
  @@map("user_roles")
}

/// Server-side refresh session. The refresh token itself is opaque and never persisted;
/// only its SHA-256 digest is stored, so a database read cannot reconstruct a usable
/// credential. Rotation is an atomic conditional UPDATE on token_hash (see
/// docs/architecture/authentication-session-security.md).
model AuthSession {
  id               String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String                       @map("organization_id") @db.Uuid
  userId           String                       @map("user_id") @db.Uuid
  /// Every session descending from one login shares a family. Detected reuse revokes the
  /// whole family, not just the replayed session.
  familyId         String                       @map("family_id") @db.Uuid
  tokenHash        Bytes                        @unique(map: "auth_sessions_token_hash_key") @map("token_hash")
  issuedAt         DateTime                     @default(now()) @map("issued_at") @db.Timestamptz(3)
  /// Absolute lifetime. A successor inherits its predecessor's value; rotation never
  /// extends a session.
  expiresAt        DateTime                     @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?                    @map("revoked_at") @db.Timestamptz(3)
  revocationReason AuthSessionRevocationReason? @map("revocation_reason")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id], map: "auth_sessions_organization_id_id_key")
  @@index([organizationId, userId, issuedAt(sort: Desc)], map: "auth_sessions_organization_id_user_id_issued_at_idx")
  @@index([familyId], map: "auth_sessions_family_id_idx")
  @@map("auth_sessions")
}

/// A requester's statement of need (FR-020). Tenant-owned: `organization_id` is present on
/// the row and on every relationship it takes part in, so PostgreSQL — not only application
/// code — refuses a reference that crosses an Organization (ADR-002).
model PurchaseRequest {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                @map("organization_id") @db.Uuid
  requesterId    String                @map("requester_id") @db.Uuid
  /// BR-042. The requester's Department at creation time. Persisted on the request rather
  /// than read through the User, so moving a person between Departments later cannot
  /// retroactively reassign the requests they already raised.
  departmentId   String                @map("department_id") @db.Uuid
  status         PurchaseRequestStatus @default(DRAFT)
  justification  String                @db.VarChar(2000)
  /// Calendar date, not an instant: "needed by the 5th" is the same day in every timezone.
  neededBy       DateTime              @map("needed_by") @db.Date
  /// BR-031/BR-032. Integer centavos, computed by the backend from the items. BIGINT is a
  /// storage width, not a business ceiling: it is the largest amount this system stores
  /// exactly, and it reaches the wire as a string so no JSON number has to hold it.
  estimatedTotalCents BigInt           @map("estimated_total_cents")
  submittedAt    DateTime?             @map("submitted_at") @db.Timestamptz(3)
  cancelledAt    DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requester    User         @relation(fields: [organizationId, requesterId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  department   Department   @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  items        PurchaseRequestItem[]
  approvalFlow ApprovalFlow?
  approvalSteps ApprovalStep[]
  supplierQuotes SupplierQuote[]
  supplierQuoteItems SupplierQuoteItem[]
  purchaseOrder PurchaseOrder?

  @@unique([organizationId, id], map: "purchase_requests_organization_id_id_key")
  @@index([organizationId, requesterId, createdAt(sort: Desc), id(sort: Desc)], map: "purchase_requests_organization_id_requester_id_created_at_idx")
  /// FR-030. The manager queue: one department's requests in one state, newest first.
  @@index([organizationId, departmentId, status, createdAt(sort: Desc), id(sort: Desc)], map: "purchase_requests_organization_id_department_id_status_idx")
  @@map("purchase_requests")
}

/// One line of a need (FR-021). It has no independent life: it exists only inside its
/// PurchaseRequest, which is why the relationship cascades on delete.
model PurchaseRequestItem {
  id                String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String @map("organization_id") @db.Uuid
  purchaseRequestId String @map("purchase_request_id") @db.Uuid
  /// Server-assigned, 1-based. Gives the list a deterministic order that does not depend on
  /// physical row order or on a client-supplied sort key.
  position          Int
  description       String @db.VarChar(500)
  unitOfMeasure     String @map("unit_of_measure") @db.VarChar(20)
  /// Exact decimal, never binary floating point. The scale of 3 is a technical
  /// representation constraint — the precision the system keeps and round-trips — and not a
  /// limit on how much may be requested. The application holds it as an integer count of
  /// thousandths; see apps/api/src/procurement/application/support/decimal-quantity.ts.
  quantity          Decimal @db.Decimal(20, 3)
  /// BR-021/BR-031. The requester's expectation in integer centavos, never a purchase-order
  /// price. BIGINT for the same storage reason as the request total.
  estimatedUnitPriceCents BigInt @map("estimated_unit_price_cents")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  purchaseRequest PurchaseRequest @relation(fields: [organizationId, purchaseRequestId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  supplierQuoteItems SupplierQuoteItem[]

  @@unique([organizationId, id], map: "purchase_request_items_organization_id_id_key")
  @@unique([organizationId, purchaseRequestId, position], map: "purchase_request_items_organization_id_request_id_position_key")
  /// Candidate key for BR-021's strongest guarantee: a SupplierQuoteItem carries the request
  /// its quote belongs to and points at a line through *this* key, so PostgreSQL refuses a
  /// quote line that prices an item of a different request — even one in the same tenant.
  @@unique([organizationId, purchaseRequestId, id], map: "purchase_request_items_organization_id_request_id_id_key")
  @@map("purchase_request_items")
}

/// The role a single Approval Step is assigned to (BR-001). Deliberately not `Role`: an
/// approval step names a *responsibility in the flow*, and the principal role that may act
/// on it is a separate mapping — Purchasing steps are decided by a BUYER. Collapsing the two
/// would make the flow depend on the identity module's role vocabulary.
enum ApprovalStepRole {
  MANAGER
  PURCHASING
  FINANCE

  @@map("approval_step_role")
}

/// The lifecycle of one Approval Step, stated explicitly rather than inferred from which
/// timestamps happen to be null. `ACTIONABLE` is the single step a flow is waiting on;
/// `PENDING` steps exist but may not be decided until the steps before them complete
/// (FR-035). `VOIDED` records a step that will never be decided — a cancelled request, or a
/// rejected flow — without deleting it (BR-003, AUD-003).
enum ApprovalStepState {
  PENDING
  ACTIONABLE
  APPROVED
  REJECTED
  VOIDED

  @@map("approval_step_state")
}

/// `ACTIVE` while any step may still be decided, `COMPLETED` once every materialized step
/// has been, `REJECTED` when a step refused the request, `VOIDED` when the request was
/// cancelled before the flow finished.
enum ApprovalFlowState {
  ACTIVE
  COMPLETED
  REJECTED
  VOIDED

  @@map("approval_flow_state")
}

/// AUD-001, restricted to the transitions this phase can actually produce. A value is added
/// when the action that emits it exists, not before.
enum AuditEventType {
  PURCHASE_REQUEST_SUBMITTED
  PURCHASE_REQUEST_CANCELLED
  APPROVAL_STEP_APPROVED
  APPROVAL_STEP_REJECTED
  SUPPLIER_CREATED
  SUPPLIER_DEACTIVATED
  SUPPLIER_QUOTE_REGISTERED
  SUPPLIER_QUOTE_WITHDRAWN
  SUPPLIER_QUOTE_SELECTED
  /// BR-003. Emitted only when the re-evaluation actually changed the ladder, so the trail
  /// records a decision rather than the fact that a rule was consulted.
  APPROVAL_FLOW_REEVALUATED
  PURCHASE_ORDER_ISSUED
  PURCHASE_ORDER_CANCELLED

  @@map("audit_event_type")
}

/// The aggregate an Audit Event is filed under. All four events of this phase are facts
/// about one PurchaseRequest, so the decision events name the request and carry the step's
/// identity in their payload — that is what makes the decisions on a request reconstructable
/// in one ordered read (AUD-005).
enum AuditAggregateType {
  PURCHASE_REQUEST
  /// A Supplier's own lifecycle is not a fact about any one request, so it is filed under the
  /// Supplier. Quote facts stay filed under the PurchaseRequest they belong to, which is what
  /// keeps the decisions on one request reconstructable in a single ordered read (AUD-005).
  SUPPLIER
  PURCHASE_ORDER

  @@map("audit_aggregate_type")
}

/// FR-024. Materialized when a PurchaseRequest is submitted, in the same transaction as the
/// transition, and never before: a flow without a submitted request is not a state the
/// domain has.
model ApprovalFlow {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  purchaseRequestId String            @map("purchase_request_id") @db.Uuid
  state             ApprovalFlowState @default(ACTIVE)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  purchaseRequest PurchaseRequest @relation(fields: [organizationId, purchaseRequestId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  steps           ApprovalStep[]

  @@unique([organizationId, id], map: "approval_flows_organization_id_id_key")
  /// Exactly one flow per request in this phase (FR-024). BR-003 extends an existing flow
  /// rather than creating a second one.
  @@unique([organizationId, purchaseRequestId], map: "approval_flows_organization_id_purchase_request_id_key")
  /// Lets a step prove, in PostgreSQL, that it belongs to the same request as its flow.
  @@unique([organizationId, id, purchaseRequestId], map: "approval_flows_organization_id_id_request_id_key")
  @@map("approval_flows")
}

/// One required approval in the flow (BR-001). `sequence` is server-assigned, 1-based and
/// gap-free at creation, so the order of the ladder never depends on physical row order.
model ApprovalStep {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  approvalFlowId    String            @map("approval_flow_id") @db.Uuid
  /// Denormalized from the flow and proven equal to it by a composite foreign key, so a
  /// step can be read for a request without joining through the flow.
  purchaseRequestId String            @map("purchase_request_id") @db.Uuid
  sequence          Int
  role              ApprovalStepRole
  state             ApprovalStepState @default(PENDING)
  /// FR-036/BR-002. The amount this step was evaluated against, captured when the step was
  /// materialized. Integer centavos, for the same reasons as every other amount (BR-031).
  evaluatedAmountCents BigInt         @map("evaluated_amount_cents")
  decidedById       String?           @map("decided_by_id") @db.Uuid
  decidedAt         DateTime?         @map("decided_at") @db.Timestamptz(3)
  /// FR-031. Mandatory for a rejection and at least 10 non-whitespace characters; optional
  /// for an approval, and stored trimmed when given.
  decisionReason    String?           @map("decision_reason") @db.VarChar(2000)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approvalFlow    ApprovalFlow    @relation(fields: [organizationId, approvalFlowId, purchaseRequestId], references: [organizationId, id, purchaseRequestId], onDelete: Restrict, onUpdate: Restrict)
  purchaseRequest PurchaseRequest @relation(fields: [organizationId, purchaseRequestId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy       User?           @relation(fields: [organizationId, decidedById], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id], map: "approval_steps_organization_id_id_key")
  @@unique([organizationId, approvalFlowId, sequence], map: "approval_steps_organization_id_flow_id_sequence_key")
  @@index([organizationId, purchaseRequestId, sequence], map: "approval_steps_organization_id_request_id_sequence_idx")
  @@map("approval_steps")
}

/// AUD-002. Append-only: the application has no update and no delete path, and a PostgreSQL
/// trigger refuses both regardless of caller (AUD-003).
/// REL-002. The publication lifecycle of one committed outgoing fact. `PENDING` is claimable
/// once `next_attempt_at` has passed; `PUBLISHING` is leased by exactly one relay instance;
/// `PUBLISHED` is confirmed by the broker; `FAILED` has exhausted its bounded attempts and is
/// parked for inspection rather than dropped (REL-006).
enum OutboxMessageStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED

  @@map("outbox_message_status")
}

/// The outgoing facts this phase actually emits. Like `AuditEventType`, a value is added when
/// the transition that emits it exists, not in anticipation of one.
enum OutboxEventType {
  PURCHASE_REQUEST_SUBMITTED
  PURCHASE_REQUEST_APPROVAL_DECIDED
  PURCHASE_REQUEST_QUOTE_SELECTED
  PURCHASE_ORDER_ISSUED

  @@map("outbox_event_type")
}

/// The aggregate an outgoing fact is about. Separate from `AuditAggregateType` on purpose:
/// the audit trail and the outbox are different concerns with different lifecycles, and
/// sharing one enum would couple what may be audited to what may be published.
enum OutboxAggregateType {
  PURCHASE_REQUEST
  PURCHASE_ORDER

  @@map("outbox_aggregate_type")
}

/// REL-002's committed intent. Written in the *same* transaction as the business change and
/// its audit event, so a rolled-back transition leaves no intent and a committed one cannot
/// lose its side effect (ADR-003).
///
/// This table is **mutable operational state**, and deliberately carries none of the
/// append-only protection `audit_events` has. A published row is a transport receipt, not
/// history: the relay updates its status, its lease and its attempt counter throughout its
/// life, and a later retention job may delete it. The audit trail is what must never change.
///
/// There is no `consumed_at`: publication and consumption are separate concerns, and one
/// event may have several independent consumers. A consumer records its own receipt.
model OutboxMessage {
  /// The stable end-to-end event identity. It becomes the AMQP `messageId` and the durable
  /// consumer deduplication key, so there is deliberately no second event identifier.
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  eventType      OutboxEventType     @map("event_type")
  /// Lets a consumer refuse a shape it does not understand instead of guessing at it.
  schemaVersion  Int                 @default(1) @map("schema_version") @db.SmallInt
  aggregateType  OutboxAggregateType @map("aggregate_type")
  aggregateId    String              @map("aggregate_id") @db.Uuid
  /// NFR-008. Carried from the originating request into the asynchronous continuation, so one
  /// identifier links the API log line, the message and the consumer's log line.
  correlationId  String              @map("correlation_id") @db.Uuid
  occurredAt     DateTime            @map("occurred_at") @db.Timestamptz(3)
  /// Scalars only, and every amount is a digit string rather than a JSON number (BR-031).
  /// Justifications, decision reasons, names, emails and credentials never appear here.
  payload        Json
  status         OutboxMessageStatus @default(PENDING)
  attemptCount   Int                 @default(0) @map("attempt_count")
  nextAttemptAt  DateTime            @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  /// The relay instance holding the publication lease, and when that lease expires. A relay
  /// that dies mid-publication leaves an expired lease, which is what makes the row claimable
  /// again without any separate reconciliation job.
  leasedBy       String?             @map("leased_by") @db.VarChar(100)
  leaseExpiresAt DateTime?           @map("lease_expires_at") @db.Timestamptz(3)
  publishedAt    DateTime?           @map("published_at") @db.Timestamptz(3)
  /// A short, non-sensitive diagnostic. Never a stack trace, a payload or a credential.
  lastError      String?             @map("last_error") @db.VarChar(500)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id], map: "outbox_messages_organization_id_id_key")
  /// The relay's claim scan. Deliberately *not* led by organization_id: this is a trusted
  /// cross-tenant infrastructure sweep, not a product query, and the distinction is made
  /// explicit by the separately named claim operation that is the only caller.
  @@index([nextAttemptAt, createdAt, id], map: "outbox_messages_claimable_idx")
  @@index([leaseExpiresAt], map: "outbox_messages_expired_lease_idx")
  /// Investigation: what this tenant emitted about this aggregate, in order.
  @@index([organizationId, aggregateType, aggregateId, createdAt], map: "outbox_messages_organization_id_aggregate_idx")
  @@map("outbox_messages")
}

/// REL-003. One consumer's durable proof that it has already processed one event.
///
/// The primary key is the idempotency mechanism: a redelivered message loses the insert and
/// the consumer produces no second effect. Broker redelivery semantics are not an idempotency
/// mechanism and this table exists because they are not.
///
/// There is deliberately no foreign key to `outbox_messages`: a `RESTRICT` reference would
/// make every receipt a reason its outbox row cannot be retained-and-pruned later, and a
/// `CASCADE` would silently delete the proof that something was already processed. The
/// consumer validates the originating row by `(organization_id, id)` instead.
model OutboxConsumerReceipt {
  /// Stable logical name of the consumer. Two consumers of the same event each keep their own
  /// receipt, which is why the consumer is part of the key.
  consumer       String   @db.VarChar(100)
  /// `outbox_messages.id`, taken from the envelope and validated against the persisted row.
  eventId        String   @map("event_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  eventType      OutboxEventType @map("event_type")
  /// How many times the broker had already delivered this message when it finally succeeded.
  /// Operational evidence that redelivery happened and was absorbed, not a control field.
  deliveryCount  Int      @default(1) @map("delivery_count")
  processedAt    DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([consumer, eventId], map: "outbox_consumer_receipts_pkey")
  @@index([organizationId, processedAt], map: "outbox_consumer_receipts_organization_id_processed_at_idx")
  @@map("outbox_consumer_receipts")
}

model AuditEvent {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  actorId        String             @map("actor_id") @db.Uuid
  eventType      AuditEventType     @map("event_type")
  aggregateType  AuditAggregateType @map("aggregate_type")
  aggregateId    String             @map("aggregate_id") @db.Uuid
  /// AUD-005. 1-based and unique per (organization, aggregate), assigned inside the same
  /// transaction as the business change, so the events of one aggregate have one
  /// unambiguous order that does not depend on clock resolution.
  sequence       Int
  occurredAt     DateTime           @map("occurred_at") @db.Timestamptz(3)
  /// Typed at the emitting boundary; JSON here. Amounts inside it are digit *strings* for
  /// the same reason they are strings on the wire: a JSON number is a double to every
  /// reader (BR-031).
  payload        Json
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor        User         @relation(fields: [organizationId, actorId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, aggregateType, aggregateId, sequence], map: "audit_events_organization_id_aggregate_sequence_key")
  @@map("audit_events")
}

/// FR-010/FR-013. How a Supplier's fiscal identity is to be read.
///
/// The type is modelled explicitly rather than inferred from the shape of the string,
/// because "14 digits" is not a claim about a country and inference is not a decision. CNPJ
/// means the value was normalized to its 14 digits and its check digits were verified.
/// `OTHER` means the organization supplied an identifier this system stores faithfully and
/// deliberately does not claim to have validated against any national registry.
enum SupplierTaxIdentifierType {
  CNPJ
  OTHER

  @@map("supplier_tax_identifier_type")
}

/// BR-022/BR-024. `ACTIVE` is a live offer; `WITHDRAWN` is one the Buyer took back and which
/// stays visible in history (FR-046); `SELECTED` is the single winning quote of a request.
/// Both terminal states are recorded, never deleted.
enum SupplierQuoteStatus {
  ACTIVE
  WITHDRAWN
  SELECTED

  @@map("supplier_quote_status")
}

/// FR-054. Cancellation is terminal and does not reopen the request it came from (BR-013).
enum PurchaseOrderStatus {
  ISSUED
  CANCELLED

  @@map("purchase_order_status")
}

/// REL-004's four operations, named exactly as the requirement names them. A value exists
/// when the durable operation exists; there is no generic "any request" idempotency.
enum IdempotentOperation {
  PURCHASE_REQUEST_SUBMISSION
  APPROVAL_DECISION
  QUOTE_SELECTION
  PURCHASE_ORDER_ISSUANCE

  @@map("idempotent_operation")
}

/// FR-010/FR-011. A tenant-owned Supplier. Never shared across organizations (MT-002), and
/// never deleted: FR-012 deactivates, because historical quotes and purchase orders keep
/// pointing here.
model Supplier {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  legalName      String                    @map("legal_name") @db.VarChar(200)
  tradeName      String                    @map("trade_name") @db.VarChar(200)
  taxIdentifierType SupplierTaxIdentifierType @map("tax_identifier_type")
  /// As the organization supplied it, trimmed. Kept so a person can recognize what they
  /// typed; never the value uniqueness is decided on.
  taxIdentifier  String                    @map("tax_identifier") @db.VarChar(40)
  /// FR-013/MT-006. The comparison form: 14 digits for a CNPJ, uppercase alphanumerics for
  /// OTHER. Uniqueness is `(organization_id, tax_identifier_normalized)` regardless of type,
  /// so two spellings of one identifier cannot both be registered.
  taxIdentifierNormalized String            @map("tax_identifier_normalized") @db.VarChar(40)
  contactEmail   String                    @map("contact_email") @db.VarChar(320)
  contactPhone   String                    @map("contact_phone") @db.VarChar(40)
  isActive       Boolean                   @default(true) @map("is_active")
  deactivatedAt  DateTime?                 @map("deactivated_at") @db.Timestamptz(3)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  quotes       SupplierQuote[]
  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, id], map: "suppliers_organization_id_id_key")
  @@unique([organizationId, taxIdentifierNormalized], map: "suppliers_organization_id_tax_identifier_normalized_key")
  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)], map: "suppliers_organization_id_created_at_idx")
  @@map("suppliers")
}

/// FR-040–FR-042. One supplier's priced answer to one request.
///
/// Every amount is server-computed (BR-032): `items_total_cents` is the sum of the already
/// rounded line totals, and `total_cents` is that plus freight minus discount. A CHECK
/// re-states the identity, so a row whose total disagrees with its parts cannot exist.
model SupplierQuote {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  purchaseRequestId String              @map("purchase_request_id") @db.Uuid
  supplierId        String              @map("supplier_id") @db.Uuid
  status            SupplierQuoteStatus @default(ACTIVE)
  freightCents      BigInt              @map("freight_cents")
  discountCents     BigInt              @map("discount_cents")
  itemsTotalCents   BigInt              @map("items_total_cents")
  totalCents        BigInt              @map("total_cents")
  /// BR-021. Persisted so the deferred coverage trigger has something to compare against
  /// without counting twice, and so a quote row alone states how many lines it must have.
  itemCount         Int                 @map("item_count")
  /// BR-023. Calendar date, inclusive: a quote is selectable *on* its validity date.
  validUntil        DateTime            @map("valid_until") @db.Date
  deliveryLeadTimeDays Int              @map("delivery_lead_time_days")
  registeredById    String              @map("registered_by_id") @db.Uuid
  /// FR-044. Mandatory when a quote is selected, at least 10 non-whitespace characters. It
  /// stays in tenant-scoped storage and never reaches a broker payload.
  selectionRationale String?            @map("selection_rationale") @db.VarChar(2000)
  selectedById      String?             @map("selected_by_id") @db.Uuid
  selectedAt        DateTime?           @map("selected_at") @db.Timestamptz(3)
  withdrawnAt       DateTime?           @map("withdrawn_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  purchaseRequest PurchaseRequest @relation(fields: [organizationId, purchaseRequestId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  supplier        Supplier        @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  registeredBy    User            @relation("SupplierQuoteRegisteredBy", fields: [organizationId, registeredById], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  selectedBy      User?           @relation("SupplierQuoteSelectedBy", fields: [organizationId, selectedById], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  items           SupplierQuoteItem[]
  /// Declared one-to-many only because Prisma requires the *relation's own* field list to be
  /// unique for a one-to-one, and that list is the four-column tenant/quote/request/supplier
  /// key. At most one order can exist per quote all the same: the narrower
  /// `(organization_id, supplier_quote_id)` unique constraint below is what enforces it.
  purchaseOrders  PurchaseOrder[]

  @@unique([organizationId, id], map: "supplier_quotes_organization_id_id_key")
  /// Lets a quote line prove, in PostgreSQL, that it belongs to the same request as its quote.
  @@unique([organizationId, id, purchaseRequestId], map: "supplier_quotes_organization_id_id_request_id_key")
  /// Lets a PurchaseOrder prove, in PostgreSQL, that the supplier it names is the supplier of
  /// the quote it was derived from. Application convention alone is not sufficient (FR-051).
  @@unique([organizationId, id, purchaseRequestId, supplierId], map: "supplier_quotes_organization_id_id_request_id_supplier_id_key")
  @@index([organizationId, purchaseRequestId, totalCents], map: "supplier_quotes_organization_id_request_id_total_idx")
  @@map("supplier_quotes")
}

/// FR-041. One quoted line, in one-to-one correspondence with a PurchaseRequestItem.
///
/// `quantity` is copied from the request line at registration and is never client input: a
/// buyer prices what was asked for, they do not restate it (BR-025). `line_total_cents` is
/// half-up rounded once at the line (BR-033).
model SupplierQuoteItem {
  id                    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String  @map("organization_id") @db.Uuid
  supplierQuoteId       String  @map("supplier_quote_id") @db.Uuid
  /// Denormalized from the quote and proven equal to it by a composite foreign key, so the
  /// request line this prices can be constrained to the same request in the database.
  purchaseRequestId     String  @map("purchase_request_id") @db.Uuid
  purchaseRequestItemId String  @map("purchase_request_item_id") @db.Uuid
  position              Int
  quantity              Decimal @db.Decimal(20, 3)
  unitPriceCents        BigInt  @map("unit_price_cents")
  lineTotalCents        BigInt  @map("line_total_cents")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supplierQuote       SupplierQuote       @relation(fields: [organizationId, supplierQuoteId, purchaseRequestId], references: [organizationId, id, purchaseRequestId], onDelete: Cascade, onUpdate: Restrict)
  purchaseRequest     PurchaseRequest     @relation(fields: [organizationId, purchaseRequestId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  purchaseRequestItem PurchaseRequestItem @relation(fields: [organizationId, purchaseRequestId, purchaseRequestItemId], references: [organizationId, purchaseRequestId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id], map: "supplier_quote_items_organization_id_id_key")
  /// BR-021's "no duplicate": one quote prices each request line at most once.
  @@unique([organizationId, supplierQuoteId, purchaseRequestItemId], map: "supplier_quote_items_organization_id_quote_id_request_item_key")
  @@unique([organizationId, supplierQuoteId, position], map: "supplier_quote_items_organization_id_quote_id_position_key")
  @@map("supplier_quote_items")
}

/// FR-050–FR-053. A historical snapshot, deliberately independent of the rows it was copied
/// from: supplier records, quotes and request lines may change afterwards and a purchase
/// order must not (FR-051). That is why the line table below holds no foreign key back to a
/// quote line or a request line.
model PurchaseOrder {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  purchaseRequestId String              @map("purchase_request_id") @db.Uuid
  supplierQuoteId   String              @map("supplier_quote_id") @db.Uuid
  supplierId        String              @map("supplier_id") @db.Uuid
  /// FR-053. `PO-000001`, unique within the organization. Allocated inside the issuance
  /// transaction from the tenant's own counter, so a rollback consumes no visible number.
  number            String              @db.VarChar(20)
  sequenceValue     BigInt              @map("sequence_value")
  status            PurchaseOrderStatus @default(ISSUED)
  /// Snapshot fields. Trade name, contact email and contact phone are deliberately absent:
  /// a purchase order needs the legal identity it was issued against, not the supplier's
  /// contact book (SEC-009).
  supplierLegalName String              @map("supplier_legal_name") @db.VarChar(200)
  supplierTaxIdentifier String          @map("supplier_tax_identifier") @db.VarChar(40)
  supplierTaxIdentifierType SupplierTaxIdentifierType @map("supplier_tax_identifier_type")
  freightCents      BigInt              @map("freight_cents")
  discountCents     BigInt              @map("discount_cents")
  itemsTotalCents   BigInt              @map("items_total_cents")
  totalCents        BigInt              @map("total_cents")
  deliveryLeadTimeDays Int              @map("delivery_lead_time_days")
  issuedById        String              @map("issued_by_id") @db.Uuid
  issuedAt          DateTime            @map("issued_at") @db.Timestamptz(3)
  cancelledById     String?             @map("cancelled_by_id") @db.Uuid
  cancelledAt       DateTime?           @map("cancelled_at") @db.Timestamptz(3)
  /// FR-054. Tenant-scoped auditable text; like the selection rationale it never leaves in a
  /// broker payload.
  cancellationReason String?            @map("cancellation_reason") @db.VarChar(2000)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  purchaseRequest PurchaseRequest @relation(fields: [organizationId, purchaseRequestId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Four columns, not one: the order's supplier must be the supplier of the quote it was
  /// derived from, and PostgreSQL is what proves it.
  supplierQuote   SupplierQuote   @relation(fields: [organizationId, supplierQuoteId, purchaseRequestId, supplierId], references: [organizationId, id, purchaseRequestId, supplierId], onDelete: Restrict, onUpdate: Restrict)
  supplier        Supplier        @relation(fields: [organizationId, supplierId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  issuedBy        User            @relation("PurchaseOrderIssuedBy", fields: [organizationId, issuedById], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  cancelledBy     User?           @relation("PurchaseOrderCancelledBy", fields: [organizationId, cancelledById], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  items           PurchaseOrderItem[]

  @@unique([organizationId, id], map: "purchase_orders_organization_id_id_key")
  @@unique([organizationId, number], map: "purchase_orders_organization_id_number_key")
  /// FR-050: exactly one purchase order per approved request, and one per selected quote.
  @@unique([organizationId, purchaseRequestId], map: "purchase_orders_organization_id_purchase_request_id_key")
  @@unique([organizationId, supplierQuoteId], map: "purchase_orders_organization_id_supplier_quote_id_key")
  @@index([organizationId, issuedAt(sort: Desc), id(sort: Desc)], map: "purchase_orders_organization_id_issued_at_idx")
  @@map("purchase_orders")
}

/// FR-051. A copied line. Description, unit of measure, quantity and position come from the
/// request line; unit price and line total come from the selected quote line. There is no
/// foreign key to either, on purpose: a snapshot that a later edit can drag along is not a
/// snapshot.
model PurchaseOrderItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  position        Int
  description     String   @db.VarChar(500)
  unitOfMeasure   String   @map("unit_of_measure") @db.VarChar(20)
  quantity        Decimal  @db.Decimal(20, 3)
  unitPriceCents  BigInt   @map("unit_price_cents")
  lineTotalCents  BigInt   @map("line_total_cents")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  purchaseOrder PurchaseOrder @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, id], map: "purchase_order_items_organization_id_id_key")
  @@unique([organizationId, purchaseOrderId, position], map: "purchase_order_items_organization_id_order_id_position_key")
  @@map("purchase_order_items")
}

/// FR-053/MT-006. One counter per tenant, so `PO-000001` is the first order of *every*
/// organization and no tenant can infer another's volume from its numbering.
///
/// Allocation is a single `INSERT … ON CONFLICT DO UPDATE … RETURNING` inside the issuance
/// transaction: the row lock serializes concurrent issuances, and a rollback returns the
/// counter with it, so a failed issuance consumes no visible number.
model PurchaseOrderNumberSequence {
  organizationId String   @id @map("organization_id") @db.Uuid
  /// The value the *next* allocation will hand out. Starts at 1 and is never reused.
  nextValue      BigInt   @default(1) @map("next_value")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("purchase_order_number_sequences")
}

/// REL-004. One durable client operation, remembered so a retry cannot repeat its effects.
///
/// What is stored is deliberately minimal: two digests and a bounded scalar outcome. The
/// Idempotency-Key itself is never persisted — only its SHA-256 — and neither is the request
/// body. `request_fingerprint` is a SHA-256 over the *normalized semantic* request, so the
/// same key presented with a different meaning is refused (409) instead of replaying an
/// answer to a question nobody asked.
///
/// Retention is not implemented in this phase, and that is a stated limitation rather than an
/// oversight: rows accumulate until a retention capability exists. See
/// docs/architecture/client-idempotency.md.
model IdempotencyRecord {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  /// REL-004 records are actor-bound: two users presenting the same key are two operations.
  actorId        String              @map("actor_id") @db.Uuid
  operation      IdempotentOperation
  idempotencyKeyHash Bytes           @map("idempotency_key_hash")
  requestFingerprint Bytes           @map("request_fingerprint")
  /// Scalars only, and never free text, a fiscal identifier, a name, an address or a token.
  /// `null` exists only *inside* the reserving transaction; a deferred constraint trigger
  /// refuses to commit a reservation that never completed.
  outcome        Json?
  completedAt    DateTime?           @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor        User         @relation(fields: [organizationId, actorId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, actorId, operation, idempotencyKeyHash], map: "idempotency_records_organization_actor_operation_key_hash_key")
  @@index([organizationId, createdAt], map: "idempotency_records_organization_id_created_at_idx")
  @@map("idempotency_records")
}
