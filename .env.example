# Copy this file to .env for local development. All values are development-only placeholders.
NODE_ENV=development

# API
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Authoritative persistence used by the API
DATABASE_URL=postgresql://vendorflow:vendorflow@localhost:5432/vendorflow?schema=public

# Authentication (development-only placeholders; production values come from the secret store)
# AUTH_JWT_SECRET must supply at least 32 bytes of key material and has no default.
# Generate a real one with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=development-only-access-token-signing-key-change-me
AUTH_JWT_ISSUER=vendorflow
AUTH_JWT_AUDIENCE=vendorflow-api
# 15 minutes. Access tokens live only in frontend memory and are never stored in a cookie.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# 30 days, absolute. Refresh rotation never extends this lifetime.
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# Auth abuse limits. In-memory only: correct for a single API instance, see
# docs/architecture/authentication-session-security.md before scaling the API horizontally.
AUTH_IP_RATE_LIMIT=10
AUTH_IP_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_ACCOUNT_MAX_FAILED_ATTEMPTS=5
AUTH_ACCOUNT_LOCKOUT_WINDOW_SECONDS=900

# SEC-006 write-route abuse limits. Two independent budgets per route — one keyed by source
# address, one by authenticated principal — both charged on every request. In-memory only, with
# the same single-instance limitation as the auth limits above.
# The Manager queue and the approval decision command.
APPROVAL_IP_RATE_LIMIT=60
APPROVAL_IP_RATE_LIMIT_WINDOW_SECONDS=60
APPROVAL_PRINCIPAL_RATE_LIMIT=30
APPROVAL_PRINCIPAL_RATE_LIMIT_WINDOW_SECONDS=60
# Quote selection: the widest transaction in the system, and the one that decides what
# Purchasing and Finance will be asked to approve.
QUOTE_SELECTION_IP_RATE_LIMIT=30
QUOTE_SELECTION_IP_RATE_LIMIT_WINDOW_SECONDS=60
QUOTE_SELECTION_PRINCIPAL_RATE_LIMIT=15
QUOTE_SELECTION_PRINCIPAL_RATE_LIMIT_WINDOW_SECONDS=60
# Purchase order issuance and cancellation. Issuance serializes every buyer in the organization
# on one counter row, so its budget is the tightest here.
PURCHASE_ORDER_IP_RATE_LIMIT=30
PURCHASE_ORDER_IP_RATE_LIMIT_WINDOW_SECONDS=60
PURCHASE_ORDER_PRINCIPAL_RATE_LIMIT=15
PURCHASE_ORDER_PRINCIPAL_RATE_LIMIT_WINDOW_SECONDS=60

# Worker messaging
RABBITMQ_URL=amqp://vendorflow:vendorflow@localhost:5672
# Namespace for every exchange and queue the worker declares.
RABBITMQ_TOPOLOGY_PREFIX=vendorflow
# Unacknowledged messages one consumer may hold at a time.
RABBITMQ_PREFETCH=10
# How long the worker waits before retrying a dropped broker connection. A broker outage
# never stops the worker process and never stops the API committing business decisions.
RABBITMQ_RECONNECT_DELAY_MS=5000

# Worker health and readiness (REL-008). Readiness requires PostgreSQL *and* a usable broker;
# the API's readiness deliberately does not, so decisions keep committing while the
# side-effect path is degraded (REL-007).
WORKER_PORT=3002

# Transactional outbox relay (ADR-003). The worker reads the outbox committed by the API.
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
# The publication lease. It is what lets a relay that died mid-publication be recovered, and
# it must outlive the confirm timeout below or a slow publication is claimed twice.
OUTBOX_LEASE_SECONDS=30
OUTBOX_PUBLISH_CONFIRM_TIMEOUT_MS=10000
# After this many attempts a row is parked as FAILED for inspection; it is never dropped.
OUTBOX_MAX_PUBLISH_ATTEMPTS=8
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=300000
# Consumer-side backoff ladder, one delay per RabbitMQ retry tier. Exhausting it is terminal
# and the message lands in the dead-letter queue.
CONSUMER_RETRY_DELAYS_MS=10000,60000,300000

# Optional future infrastructure; no application currently reads this value
REDIS_URL=redis://localhost:6379

# Web (public browser-visible configuration; never place secrets here)
NEXT_PUBLIC_API_URL=http://localhost:3001
