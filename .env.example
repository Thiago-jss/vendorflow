# Copy this file to .env for local development. All values are development-only placeholders.
NODE_ENV=development

# API
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Authoritative persistence used by the API
DATABASE_URL=postgresql://vendorflow:vendorflow@localhost:5432/vendorflow?schema=public

# Authentication (development-only placeholders; production values come from the secret store)
# AUTH_JWT_SECRET must supply at least 32 bytes of key material and has no default.
# Generate a real one with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=development-only-access-token-signing-key-change-me
AUTH_JWT_ISSUER=vendorflow
AUTH_JWT_AUDIENCE=vendorflow-api
# 15 minutes. Access tokens live only in frontend memory and are never stored in a cookie.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# 30 days, absolute. Refresh rotation never extends this lifetime.
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# Auth abuse limits. In-memory only: correct for a single API instance, see
# docs/architecture/authentication-session-security.md before scaling the API horizontally.
AUTH_IP_RATE_LIMIT=10
AUTH_IP_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_ACCOUNT_MAX_FAILED_ATTEMPTS=5
AUTH_ACCOUNT_LOCKOUT_WINDOW_SECONDS=900

# Worker messaging
RABBITMQ_URL=amqp://vendorflow:vendorflow@localhost:5672

# Optional future infrastructure; no application currently reads this value
REDIS_URL=redis://localhost:6379

# Web (public browser-visible configuration; never place secrets here)
NEXT_PUBLIC_API_URL=http://localhost:3001
