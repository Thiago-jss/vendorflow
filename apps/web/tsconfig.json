{
  "extends": "../../packages/config/next.json",
  "compilerOptions": {
    "baseUrl": ".",
    // Next rewrites a tsconfig that lacks the DOM libraries during `next build`; declaring
    // them here keeps the committed configuration and the build in agreement.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts", "vitest.config.ts", "vitest.setup.ts"],
  "exclude": ["node_modules"]
}
